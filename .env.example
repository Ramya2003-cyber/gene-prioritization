# Free LLM via any OpenAI-compatible endpoint. Default: Google Gemini free tier
# (get a key at https://aistudio.google.com/apikey).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
# Alternatives: Groq  -> LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#               Mistral -> LLM_BASE_URL=https://api.mistral.ai/v1    LLM_MODEL=mistral-small-latest
LLM_MAX_CALLS_PER_SEARCH=4

# Comma-separated origins allowed to call the API (your GitHub Pages URL), or *
ALLOWED_ORIGINS=*
RATE_LIMIT_PER_HOUR=20
MAX_CONCURRENT_SEARCHES=2
